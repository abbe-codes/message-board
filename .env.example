# Application ports
API_PORT=4000
WEB_PORT=3000

# Database
POSTGRES_DB=challenge_messages
POSTGRES_USER=challenge_user
POSTGRES_PASSWORD=challenge_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://challenge_user:challenge_password@localhost:5432/challenge_messages?schema=public

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-for-local-development
JWT_EXPIRES_IN=7d

# Auth cookie
AUTH_COOKIE_NAME=sde_challenge_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Browser/API integration
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
